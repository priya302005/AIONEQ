# EchoMind frontend configuration (copy to .env.local; never commit .env*)

# Backend API base URL (the hardened Express server).
VITE_API_URL=http://localhost:4000

# Supabase project credentials (same as backend/.env).
# NEVER put the service role key here - the browser can see this file's values.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Idle session timeout in minutes (signed out automatically after inactivity).
VITE_SESSION_TTL_MINUTES=30