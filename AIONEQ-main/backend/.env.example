# =============================================================
# EchoMind backend environment (COPY TO .env AND FILL IN)
# =============================================================
# Required
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Server
PORT=4000
# Loopback only by default. Set to 0.0.0.0 ONLY for deliberate LAN serving.
HOST=127.0.0.1
NODE_ENV=development
# Set to a positive integer when behind a TLS reverse-proxy that sets
# X-Forwarded-For (rate limiting trusts it).
TRUST_PROXY=

# Comma-separated list of allowed frontend origins (CORS, never '*')
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
RESET_REDIRECT_URL=http://localhost:5173
JSON_BODY_LIMIT=1mb

# Local LLM (must stay on localhost / private network)
LOCAL_AI_BASE_URL=http://localhost:4891
LOCAL_AI_MODEL=Llama 3.2 3B Instruct
QUERY_MAX_MEMORIES=6
# Only needed when the local server sits behind an authenticating proxy.
LOCAL_AI_API_KEY=
# Strip the prompt to fit a small-context model (e.g. a 256-token local model).
LOCAL_AI_COMPACT_PROMPT=false

# --- AI generation settings ----------------------------------------------------
# One provider, one place for every model call (services/inferenceService.js).
# Each task has its own profile (analysis / summary / answer / personalization /
# relation); the values below are the global defaults that apply to all of them.
# Lower temperature = more literal and reproducible; higher = more fluent.
AI_TEMPERATURE=0.5
AI_MAX_TOKENS=700
# Per-request deadline. Raise it for a large slow model, lower it to fail fast.
AI_TIMEOUT_MS=20000
# Extra attempts after a timeout, a 429 or a 5xx. 0 disables retrying.
AI_RETRIES=1
AI_TOP_P=0.9
AI_REPEAT_PENALTY=1.2
AI_FREQUENCY_PENALTY=0.3
AI_PRESENCE_PENALTY=0.3
# Prompt-side character budget for the memory context. It is NOT a substitute for
# the model's own context window.
AI_CONTEXT_MAX_CHARS=6000

# --- Grounding ----------------------------------------------------------------
# Validates the model's answer against the memories actually retrieved: removes
# citations to ids that were never supplied, and removes an assertion with no
# support in the excerpts it was given. Leave this ON. It may only be disabled to
# measure the grounding rate, and startup.js refuses to boot in production when
# it is off - an ungrounded answer must never be served.
AI_CLAIM_GROUNDING=true

# Meaning-based recall for personal questions. Default OFF.
# When a question is about the user's own stored life and retrieval matched
# nothing, keyword and vector scoring both fail on wording alone: "tell me my
# name" does not match a memory reading "i am Janani", because the word "name"
# is not in it. Enabling this hands the model the most recent memories so it can
# read them for meaning instead of for matching words.
# Trade-off: an extra model call on questions that may have no answer, and a
# model asked about absent data can answer anyway. An answer is therefore only
# served if it cites a supplied memory; anything uncited falls back to the honest
# "not found" reply. Keep OFF to guarantee the model is never called at all when
# retrieval is empty.
# The stronger alternative is a real embedding model plus a reindex
# (EMBEDDING_MODE), which ranks semantically without asking a model to judge
# relevance.
AI_BROAD_RECALL=false

# --- Memory understanding pipeline -------------------------------------------
# Post-save processing: transcription, document text extraction, summarisation,
# embedding. Off means memories are still saved and fully usable - only the
# intelligence layer is skipped.
MEMORY_PIPELINE_ENABLED=true
# Ceilings so one large upload can never stall a save or a retry.
PIPELINE_TIMEOUT_MS=25000
PIPELINE_MAX_CHARS=20000
# Read text out of uploaded documents (PDF/TXT/MD/CSV/RTF).
DOCUMENT_EXTRACTION_ENABLED=true
DOCUMENT_EXTRACTION_MAX_MB=25

# --- Audio transcription (optional) -------------------------------------------
# Browser-recorded voice notes already include a transcript. UPLOADED audio
# does not, so transcription needs a service. Leave the URL empty to disable:
# those memories are then marked 'partial' with a clear reason, not failed.
TRANSCRIPTION_BASE_URL=
TRANSCRIPTION_PATH=/inference
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=
TRANSCRIPTION_LANGUAGE=
TRANSCRIPTION_TIMEOUT_MS=60000

# --- Embeddings & semantic retrieval ------------------------------------------
# local  = deterministic in-process vectorizer (default, no network, no deps)
# remote = llama.cpp /embedding or an OpenAI-compatible /v1/embeddings
# off     = keyword/lexical retrieval only
EMBEDDING_MODE=local
EMBEDDING_DIM=384
EMBEDDING_MODEL=
# Rows pulled from each retrieval source before blending/reranking.
RETRIEVAL_CANDIDATE_LIMIT=40
# Cosine floor for a vector hit to count at all.
VECTOR_MIN_SIMILARITY=0.12
# Affine rescale: cosine values are mapped from
# VECTOR_MIN_SIMILARITY (measured non-gold 95th percentile)
# up to this anchor (measured gold 95th percentile), so a
# genuine semantic match can outrank a weak keyword match.
# CALIBRATION WARNING: both defaults were derived from the
# synthetic eval corpus (backend/eval/runRetrievalEval.mjs).
# Re-derive them against the real archive before production.
VECTOR_SIMILARITY_ANCHOR=0.52
# Blend of vector score vs lexical score (0 = pure keyword, 1 = pure vector).
RETRIEVAL_VECTOR_WEIGHT=0.6
# Cap on how many memories may enter the AI context for one question.
RETRIEVAL_MAX_MEMORIES=8
# Above these scores two memories look like a duplicate / the same subject evolving.
DUPLICATE_SIMILARITY=0.92
RELATED_SIMILARITY=0.55

# --- Memory listing / search ---------------------------------------------------
# Caps so the dashboard never loads an unbounded archive into the browser.
MEMORY_LIST_MAX_LIMIT=100
MEMORY_LIST_DEFAULT_LIMIT=25
MEMORY_SEARCH_MAX_LIMIT=50

# File uploads
MAX_FILE_SIZE_MB=25
# Per-user cumulative upload quota in MB (0 disables the check)
STORAGE_QUOTA_MB=0
# External malware scanner, run on every upload. E.g. ClamAV:
# SCAN_COMMAND=clamdscan   (exit 0 = clean; any failure rejects)
# When empty, uploads are NOT scanned.
SCAN_COMMAND=
# Reject uploads when no working scanner is available?
#   - production (NODE_ENV=production): defaults to TRUE (fail
#     closed - an unscanned upload is never treated as clean)
#   - development/test: defaults to FALSE (scan skipped, audited,
#     so the upload flow stays usable without a scanner)
# Override explicitly: REQUIRE_UPLOAD_SCAN=true|false
REQUIRE_UPLOAD_SCAN=

# Signed file URLs - a DEDICATED long random secret (>= 32
# characters), NEVER the Supabase anon key. Required in
# production (the server refuses to start without it). In
# development it may fall back to the anon key (with a warning).
SIGNED_URL_SECRET=change-me-to-a-long-random-string-at-least-32-chars
SIGNED_URL_TTL_SECONDS=300

# Audit logging
AUDIT_ENABLED=true
# AUDIT_LOG_PATH defaults to ./logs/audit.log

# Account lockout (in-memory; resets on restart)
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_BASE_BACKOFF_MS=30000

# Re-auth timeout for sensitive actions (minutes)
SESSION_TTL_MINUTES=30

# Legacy access verification: none | access-code | trusted-contact
#   access-code (DEFAULT, recommended): the owner sets a shared
#     access code when creating a grant; claiming needs the claim
#     token AND the code (two factors). The frontend supports this.
#   none: claim token alone (single factor) - only where you
#     explicitly accept that trade-off; not recommended in production.
# Changing this never alters existing grants silently: a grant
# created without a code simply cannot activate under access-code
# until the owner re-creates it with one (fail closed).
LEGACY_VERIFICATION=access-code
LEGACY_INCLUDE_FILES=true

# =============================================================
# Schema migration
# =============================================================
# Apply these in the Supabase SQL Editor (New query -> paste -> Run), in this
# exact order. Each file is individually idempotent, but they are NOT
# order-independent - later files reference objects earlier ones create, and
# Postgres aborts the whole statement on an unknown relation or column.
#
#   1. sql/memories.sql            creates public.memories
#   2. sql/query.sql               adds search_vector; creates public.conversations
#   3. sql/context.sql             adds memories.keywords/entities/ai_summary
#   4. sql/memory_intelligence.sql superset search_vector trigger - references
#                                 the columns added by 3, so it fails without them
#   5. sql/security.sql            policy on public.conversations - requires 2
#
# Safe to re-run any file in the same order. The app degrades gracefully if the
# later files were never applied; steps 1-2 are the minimum for auth + memories.
# The optional pgvector block at the bottom of memory_intelligence.sql is NOT
# required (vectors are stored as jsonb).

# Optional: allows account deletion to also remove the Supabase auth identity.
# NEVER put this in the frontend .env.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key