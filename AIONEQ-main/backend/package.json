{
  "name": "echomind-backend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --experimental-test-module-mocks --test tests/*.test.mjs",
    "test:unit": "node --test tests/unit.test.mjs",
    "test:isolation": "node --test tests/isolation.test.mjs",
    "test:isolation:live": "node scripts/runIsolationLive.mjs",
    "smoke": "node scripts/smokeTest.mjs",
    "eval": "node eval/runRetrievalEval.mjs",
    "eval:grounding": "node --experimental-test-module-mocks eval/groundingEval.mjs",
    "eval:ai": "node --experimental-test-module-mocks eval/aiModelEval.mjs",
    "eval:perf": "node --experimental-test-module-mocks eval/perfEval.mjs",
    "reindex:vectors": "node scripts/reindexVectors.mjs",
    "reindex:check": "node scripts/reindexVectors.mjs --check"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.115.0",
    "archiver": "8.0.0",
    "cors": "2.8.6",
    "dotenv": "18.0.5",
    "express": "4.22.3",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "multer": "2.3.0",
    "zod": "4.6.5"
  }
}
